# Server Configuration
PORT=3001
NODE_ENV=development

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-here
SIGNATURE_SECRET=your-signature-secret-key

# Webhook Configuration
WEBHOOK_SECRET=tradingview-webhook-secret

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=trading_signals
DB_USER=postgres
DB_PASSWORD=password
DB_SSL=false

# Redis Configuration (for Bull queue)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Logging
LOG_LEVEL=info

# MT5 Configuration
MT5_ACCOUNT=your_mt5_account
MT5_PASSWORD=your_mt5_password
MT5_SERVER=your_mt5_server

# Supabase Configuration (optional - for storing alerts)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Position Sizing Mode: "global" (all pairs share W-L) or "per_pair" (each pair independent)
POSITION_SIZING_MODE=global

# Backend URL for frontend (TradingView webhook - no Supabase Edge Function)
# VITE_BACKEND_URL=https://trading-backend-4v0f.onrender.com

